+using ClosedXML.Excel;
+using GamingTournament.Models;
+using QuestPDF.Fluent;
+using QuestPDF.Helpers;
+using QuestPDF.Infrastructure;
+
+namespace GamingTournament.Services;
+
+// turns a ReportData into a PDF (QuestPDF) or an Excel file (ClosedXML).
+// Static and without a database: it only formats what it is given
+public static class ReportExporter
+{
+    static ReportExporter()
+    {
+        // QuestPDF is free for non-commercial / small projects, but the
+        // license has to be chosen once before the first document
+        QuestPDF.Settings.License = LicenseType.Community;
+    }
+
+    // ---------------------------------------------------------- PDF
+
+    public static byte[] ToPdf(ReportData data)
+    {
+        return Document.Create(container =>
+        {
+            container.Page(page =>
+            {
+                page.Size(PageSizes.A4);
+                page.Margin(30);
+
+                // Arial has Cyrillic; the default QuestPDF font may not
+                page.DefaultTextStyle(style =>
+                    style.FontSize(10).FontFamily("Arial"));
+
+                page.Header().Column(column =>
+                {
+                    column.Item()
+                        .Text("GamingTournament - справка")
+                        .FontSize(18)
+                        .Bold();
+
+                    column.Item()
+                        .Text($"Генерирана на {data.GeneratedOn:dd.MM.yyyy HH:mm}")
+                        .FontSize(9)
+                        .FontColor(Colors.Grey.Darken1);
+                });
+
+                page.Content().PaddingVertical(10).Column(column =>
+                {
+                    column.Spacing(14);
+
+                    AddTable(
+                        column,
+                        "Обобщение",
+                        new[] { "Показател", "Стойност" },
+                        new float[] { 3, 1 },
+                        SummaryRows(data)
+                            .Select(row => new[]
+                            {
+                                row[0]!.ToString()!,
+                                row[1]!.ToString()!
+                            })
+                            .ToList());
+
+                    AddTable(
+                        column,
+                        "Изиграни мачове по месеци",
+                        new[] { "Месец", "Мачове" },
+                        new float[] { 2, 1 },
+                        data.MatchesByMonth
+                            .Select(item => new[]
+                            {
+                                item.Label,
+                                item.Count.ToString()
+                            })
+                            .ToList());
+
+                    AddTable(
+                        column,
+                        "Най-играни игри",
+                        new[] { "Игра", "Турнири", "Мачове" },
+                        new float[] { 3, 1, 1 },
+                        data.Games
+                            .Select(item => new[]
+                            {
+                                item.Game,
+                                item.Tournaments.ToString(),
+                                item.Matches.ToString()
+                            })
+                            .ToList());
+
+                    AddTable(
+                        column,
+                        "Заявки по месеци (играчи и треньори)",
+                        new[] { "Месец", "Одобрени", "Отхвърлени", "Чакащи" },
+                        new float[] { 2, 1, 1, 1 },
+                        data.RequestsByMonth
+                            .Select(item => new[]
+                            {
+                                item.Label,
+                                item.Approved.ToString(),
+                                item.Rejected.ToString(),
+                                item.Pending.ToString()
+                            })
+                            .ToList());
+
+                    string tournamentName =
+                        data.SelectedTournament?.Name ?? "-";
+
+                    AddTable(
+                        column,
+                        $"Класиране - {tournamentName}",
+                        new[] { "#", "Отбор", "М", "П", "Р", "З", "Голове", "Точки" },
+                        new float[] { 0.5f, 3, 0.7f, 0.7f, 0.7f, 0.7f, 1.2f, 1 },
+                        data.Standings
+                            .Select((row, index) => new[]
+                            {
+                                (index + 1).ToString(),
+                                row.TeamName,
+                                row.Played.ToString(),
+                                row.Wins.ToString(),
+                                row.Draws.ToString(),
+                                row.Losses.ToString(),
+                                $"{row.GoalsFor}:{row.GoalsAgainst}",
+                                row.Points.ToString()
+                            })
+                            .ToList());
+
+                    AddTable(
+                        column,
+                        $"Мачове - {tournamentName}",
+                        new[] { "Дата", "Домакин", "Резултат", "Гост", "Статус" },
+                        new float[] { 1.6f, 2.2f, 1, 2.2f, 1.4f },
+                        data.Matches
+                            .Select(match => new[]
+                            {
+                                match.ScheduledOn.ToString("dd.MM.yyyy HH:mm"),
+                                match.HomeTeam?.Name ?? "-",
+                                ScoreText(match),
+                                match.AwayTeam?.Name ?? "-",
+                                StatusText(match)
+                            })
+                            .ToList());
+                });
+
+                page.Footer().AlignCenter().Text(text =>
+                {
+                    text.Span("Страница ");
+                    text.CurrentPageNumber();
+                    text.Span(" от ");
+                    text.TotalPages();
+                });
+            });
+        }).GeneratePdf();
+    }
+
+    private static void AddTable(
+        ColumnDescriptor column,
+        string title,
+        string[] headers,
+        float[] widths,
+        List<string[]> rows)
+    {
+        column.Item().Text(title).FontSize(13).Bold();
+
+        if (rows.Count == 0)
+        {
+            column.Item()
+                .Text("Няма данни.")
+                .FontColor(Colors.Grey.Darken1);
+
+            return;
+        }
+
+        column.Item().Table(table =>
+        {
+            table.ColumnsDefinition(columns =>
+            {
+                foreach (float width in widths)
+                {
+                    columns.RelativeColumn(width);
+                }
+            });
+
+            table.Header(header =>
+            {
+                foreach (string text in headers)
+                {
+                    header.Cell()
+                        .Background(Colors.Grey.Lighten2)
+                        .Padding(4)
+                        .Text(text)
+                        .Bold();
+                }
+            });
+
+            foreach (string[] row in rows)
+            {
+                foreach (string value in row)
+                {
+                    table.Cell()
+                        .BorderBottom(0.5f)
+                        .BorderColor(Colors.Grey.Lighten2)
+                        .Padding(4)
+                        .Text(value);
+                }
+            }
+        });
+    }
+
+    // --------------------------------------------------------- Excel
+
+    public static byte[] ToExcel(ReportData data)
+    {
+        using XLWorkbook workbook = new XLWorkbook();
+
+        WriteSheet(
+            workbook,
+            "Обобщение",
+            new[] { "Показател", "Стойност" },
+            SummaryRows(data));
+
+        WriteSheet(
+            workbook,
+            "Класиране",
+            new[] { "#", "Отбор", "Мачове", "Победи", "Равенства",
+                    "Загуби", "Вкарани", "Получени", "Разлика", "Точки" },
+            data.Standings.Select((row, index) => new object?[]
+            {
+                index + 1,
+                row.TeamName,
+                row.Played,
+                row.Wins,
+                row.Draws,
+                row.Losses,
+                row.GoalsFor,
+                row.GoalsAgainst,
+                row.GoalDifference,
+                row.Points
+            }));
+
+        WriteSheet(
+            workbook,
+            "Мачове",
+            new[] { "Дата", "Турнир", "Домакин", "Резултат",
+                    "Гост", "Статус" },
+            data.Matches.Select(match => new object?[]
+            {
+                match.ScheduledOn,
+                data.SelectedTournament?.Name,
+                match.HomeTeam?.Name,
+                ScoreText(match),
+                match.AwayTeam?.Name,
+                StatusText(match)
+            }));
+
+        WriteSheet(
+            workbook,
+            "По месеци",
+            new[] { "Месец", "Изиграни мачове" },
+            data.MatchesByMonth.Select(item => new object?[]
+            {
+                item.Label,
+                item.Count
+            }));
+
+        WriteSheet(
+            workbook,
+            "Игри",
+            new[] { "Игра", "Турнири", "Мачове" },
+            data.Games.Select(item => new object?[]
+            {
+                item.Game,
+                item.Tournaments,
+                item.Matches
+            }));
+
+        WriteSheet(
+            workbook,
+            "Заявки",
+            new[] { "Месец", "Одобрени", "Отхвърлени", "Чакащи" },
+            data.RequestsByMonth.Select(item => new object?[]
+            {
+                item.Label,
+                item.Approved,
+                item.Rejected,
+                item.Pending
+            }));
+
+        WriteSheet(
+            workbook,
+            "Отбори",
+            new[] { "Отбор", "Държава", "Основан", "Треньор", "Играчи" },
+            data.Teams.Select(team => new object?[]
+            {
+                team.Name,
+                team.Country,
+                team.FoundedYear,
+                team.Coach?.UserName,
+                string.Join(", ", team.Members
+                    .Select(member => member.UserName))
+            }));
+
+        using MemoryStream stream = new MemoryStream();
+
+        workbook.SaveAs(stream);
+
+        return stream.ToArray();
+    }
+
+    private static void WriteSheet(
+        XLWorkbook workbook,
+        string name,
+        string[] headers,
+        IEnumerable<object?[]> rows)
+    {
+        IXLWorksheet sheet = workbook.Worksheets.Add(name);
+
+        for (int column = 0; column < headers.Length; column++)
+        {
+            sheet.Cell(1, column + 1).Value = headers[column];
+        }
+
+        IXLRange headerRow = sheet.Range(1, 1, 1, headers.Length);
+
+        headerRow.Style.Font.Bold = true;
+        headerRow.Style.Font.FontColor = XLColor.White;
+        headerRow.Style.Fill.BackgroundColor = XLColor.FromHtml("#7c5cff");
+
+        int rowNumber = 2;
+
+        foreach (object?[] row in rows)
+        {
+            for (int column = 0; column < row.Length; column++)
+            {
+                SetCell(sheet.Cell(rowNumber, column + 1), row[column]);
+            }
+
+            rowNumber++;
+        }
+
+        sheet.SheetView.FreezeRows(1);
+        sheet.Columns().AdjustToContents();
+    }
+
+    // numbers stay numbers and dates stay dates, so Excel can
+    // sort and sum them - not everything as text
+    private static void SetCell(IXLCell cell, object? value)
+    {
+        switch (value)
+        {
+            case null:
+                break;
+
+            case int number:
+                cell.Value = number;
+                break;
+
+            case DateTime date:
+                cell.Value = date;
+                cell.Style.DateFormat.Format = "dd.MM.yyyy HH:mm";
+                break;
+
+            default:
+                cell.Value = value.ToString() ?? "";
+                break;
+        }
+    }
+
+    // -------------------------------------------------------- shared
+
+    private static List<object?[]> SummaryRows(ReportData data)
+    {
+        return new List<object?[]>
+        {
+            new object?[] { "Отбори", data.TeamCount },
+            new object?[] { "Играчи в отбори", data.PlayerCount },
+            new object?[] { "Турнири", data.TournamentCount },
+            new object?[] { "Изиграни мачове", data.FinishedMatchCount },
+            new object?[] { "Предстоящи мачове", data.ScheduledMatchCount }
+        };
+    }
+
+    private static string ScoreText(Match match)
+    {
+        return match.Status == MatchStatus.Finished
+            ? $"{match.HomeScore}:{match.AwayScore}"
+            : "-";
+    }
+
+    private static string StatusText(Match match)
+    {
+        return match.Status switch
+        {
+            MatchStatus.Scheduled => "Предстоящ",
+            MatchStatus.Cancelled => "Отменен",
+            _ => match.WinnerTeamId == null ? "Равен" : "Приключил"
+        };
+    }
+}
diff --git a/GamingTournament/Services/ReportService.cs b/GamingTournament/Services/ReportService.cs
new file mode 100644
index 0000000..6fd9e9e
--- /dev/null
+++ b/GamingTournament/Services/ReportService.cs
@@ -0,0 +1,249 @@
+using GamingTournament.Data;
+using GamingTournament.Models;
+using Microsoft.EntityFrameworkCore;
+
+namespace GamingTournament.Services;
+
+public interface IReportService
+{
+    // tournamentId == null -> the newest tournament
+    Task<ReportData> BuildAsync(int? tournamentId);
+}
+
+public class ReportService : IReportService
+{
+    private readonly ApplicationDbContext _context;
+
+    public ReportService(ApplicationDbContext context)
+    {
+        _context = context;
+    }
+
+    public async Task<ReportData> BuildAsync(int? tournamentId)
+    {
+        ReportData data = new ReportData
+        {
+            TeamCount = await _context.Teams.CountAsync(),
+
+            PlayerCount = await _context.Users
+                .CountAsync(user => user.TeamId != null),
+
+            TournamentCount = await _context.Tournaments.CountAsync(),
+
+            FinishedMatchCount = await _context.Matches
+                .CountAsync(match =>
+                    match.Status == MatchStatus.Finished),
+
+            ScheduledMatchCount = await _context.Matches
+                .CountAsync(match =>
+                    match.Status == MatchStatus.Scheduled)
+        };
+
+        data.MatchesByMonth = await GetMatchesByMonthAsync();
+        data.Games = await GetGameStatsAsync();
+        data.RequestsByMonth = await GetRequestsByMonthAsync();
+
+        data.Tournaments = await _context.Tournaments
+            .AsNoTracking()
+            .OrderByDescending(tournament => tournament.StartDate)
+            .ToListAsync();
+
+        data.SelectedTournament = tournamentId == null
+            ? data.Tournaments.FirstOrDefault()
+            : data.Tournaments.FirstOrDefault(
+                tournament => tournament.Id == tournamentId);
+
+        if (data.SelectedTournament != null)
+        {
+            int selectedId = data.SelectedTournament.Id;
+
+            data.Matches = await _context.Matches
+                .AsNoTracking()
+                .Include(match => match.HomeTeam)
+                .Include(match => match.AwayTeam)
+                .Where(match => match.TournamentId == selectedId)
+                .OrderBy(match => match.ScheduledOn)
+                .ToListAsync();
+
+            data.Standings = BuildStandings(data.Matches);
+        }
+
+        data.Teams = await _context.Teams
+            .AsNoTracking()
+            .Include(team => team.Coach)
+            .Include(team => team.Members)
+            .OrderBy(team => team.Name)
+            .ToListAsync();
+
+        return data;
+    }
+
+    // Pure calculation (no database), so it is easy to unit test.
+    // 3 points for a win, 1 for a draw. Cancelled matches are ignored,
+    // scheduled ones only add the team to the table with 0 played.
+    public static List<StandingRow> BuildStandings(
+        IEnumerable<Match> matches)
+    {
+        Dictionary<int, StandingRow> rows =
+            new Dictionary<int, StandingRow>();
+
+        foreach (Match match in matches)
+        {
+            if (match.Status == MatchStatus.Cancelled)
+            {
+                continue;
+            }
+
+            StandingRow home = GetRow(
+                rows, match.HomeTeamId, match.HomeTeam?.Name);
+
+            StandingRow away = GetRow(
+                rows, match.AwayTeamId, match.AwayTeam?.Name);
+
+            if (match.Status != MatchStatus.Finished ||
+                match.HomeScore == null ||
+                match.AwayScore == null)
+            {
+                continue;
+            }
+
+            int homeScore = match.HomeScore.Value;
+            int awayScore = match.AwayScore.Value;
+
+            home.Played++;
+            away.Played++;
+
+            home.GoalsFor += homeScore;
+            home.GoalsAgainst += awayScore;
+            away.GoalsFor += awayScore;
+            away.GoalsAgainst += homeScore;
+
+            if (homeScore > awayScore)
+            {
+                home.Wins++;
+                away.Losses++;
+            }
+            else if (homeScore < awayScore)
+            {
+                away.Wins++;
+                home.Losses++;
+            }
+            else
+            {
+                home.Draws++;
+                away.Draws++;
+            }
+        }
+
+        return rows.Values
+            .OrderByDescending(row => row.Points)
+            .ThenByDescending(row => row.GoalDifference)
+            .ThenByDescending(row => row.GoalsFor)
+            .ThenBy(row => row.TeamName)
+            .ToList();
+    }
+
+    private static StandingRow GetRow(
+        Dictionary<int, StandingRow> rows,
+        int teamId,
+        string? teamName)
+    {
+        if (!rows.TryGetValue(teamId, out StandingRow? row))
+        {
+            row = new StandingRow
+            {
+                TeamId = teamId,
+                TeamName = teamName ?? ("Отбор " + teamId)
+            };
+
+            rows[teamId] = row;
+        }
+
+        return row;
+    }
+
+    // finished matches per month (by the scheduled date).
+    // Grouped in memory: SQLite can't group by year+month in SQL
+    public async Task<List<MonthlyCount>> GetMatchesByMonthAsync()
+    {
+        List<DateTime> dates = await _context.Matches
+            .AsNoTracking()
+            .Where(match => match.Status == MatchStatus.Finished)
+            .Select(match => match.ScheduledOn)
+            .ToListAsync();
+
+        return dates
+            .GroupBy(date => new DateTime(date.Year, date.Month, 1))
+            .OrderBy(group => group.Key)
+            .Select(group => new MonthlyCount
+            {
+                Month = group.Key,
+                Count = group.Count()
+            })
+            .ToList();
+    }
+
+    // which games are played the most
+    public async Task<List<GameStat>> GetGameStatsAsync()
+    {
+        var tournaments = await _context.Tournaments
+            .AsNoTracking()
+            .Select(tournament => new
+            {
+                tournament.Game,
+                MatchCount = tournament.Matches.Count(match =>
+                    match.Status != MatchStatus.Cancelled)
+            })
+            .ToListAsync();
+
+        return tournaments
+            .GroupBy(item => item.Game)
+            .Select(group => new GameStat
+            {
+                Game = group.Key,
+                Tournaments = group.Count(),
+                Matches = group.Sum(item => item.MatchCount)
+            })
+            .OrderByDescending(stat => stat.Matches)
+            .ThenBy(stat => stat.Game)
+            .ToList();
+    }
+
+    // player join requests and coach requests together, per month
+    public async Task<List<RequestMonthStat>> GetRequestsByMonthAsync()
+    {
+        var joinRequests = await _context.TeamJoinRequests
+            .AsNoTracking()
+            .Select(request => new
+            {
+                request.CreatedOn,
+                request.Status
+            })
+            .ToListAsync();
+
+        var coachRequests = await _context.CoachRequests
+            .AsNoTracking()
+            .Select(request => new
+            {
+                request.CreatedOn,
+                request.Status
+            })
+            .ToListAsync();
+
+        return joinRequests
+            .Concat(coachRequests)
+            .GroupBy(request => new DateTime(
+                request.CreatedOn.Year,
+                request.CreatedOn.Month,
+                1))
+            .OrderBy(group => group.Key)
+            .Select(group => new RequestMonthStat
+            {
+                Month = group.Key,
+                Approved = group.Count(item => item.Status == "Approved"),
+                Rejected = group.Count(item => item.Status == "Rejected"),
+                Pending = group.Count(item => item.Status == "Pending")
+            })
+            .ToList();
+    }
+}
