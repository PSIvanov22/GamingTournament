@@ -0,0 +1,136 @@
+@model List<GamingTournament.Models.ErrorLog>
+
+@{
+    ViewData["Title"] = "Журнал на грешките";
+
+    int currentPage = ViewBag.CurrentPage ?? 1;
+    int totalPages = ViewBag.TotalPages ?? 0;
+    int totalLogs = ViewBag.TotalLogs ?? 0;
+}
+
+<h1 class="page-title">Журнал на грешките</h1>
+
+@if (TempData["SuccessMessage"] != null)
+{
+    <div class="alert alert-success">
+        @TempData["SuccessMessage"]
+    </div>
+}
+
+<p class="text-muted">
+    Необработените грешки се записват и във файл
+    (<code>logs/log-ГГГГММДД.txt</code>). Кодът е същият, който
+    потребителят вижда на страницата за грешка.
+</p>
+
+@if (Model.Count == 0)
+{
+    <div class="alert alert-info">
+        Няма записани грешки.
+    </div>
+}
+else
+{
+    <div class="d-flex justify-content-between align-items-center mb-3">
+        <span class="text-muted">Общо: @totalLogs</span>
+
+        <form asp-controller="ErrorLogs"
+              asp-action="Clear"
+              method="post"
+              onsubmit="return confirm('Да изчистя ли целия журнал?');">
+            <button type="submit" class="btn btn-danger btn-sm">
+                Изчисти журнала
+            </button>
+        </form>
+    </div>
+
+    <div class="table-card table-responsive">
+        <table class="table table-hover align-middle">
+            <thead>
+            <tr>
+                <th>Час</th>
+                <th>Код</th>
+                <th>Статус</th>
+                <th>Заявка</th>
+                <th>Потребител</th>
+                <th>Грешка</th>
+            </tr>
+            </thead>
+
+            <tbody>
+            @foreach (var log in Model)
+            {
+                <tr>
+                    <td class="text-nowrap">
+                        @log.CreatedOn.ToString("dd.MM.yyyy HH:mm:ss")
+                    </td>
+
+                    <td><code>@log.TraceId</code></td>
+
+                    <td>
+                        <span class="badge @(log.StatusCode >= 500 ? "bg-danger" : "bg-warning text-dark")">
+                            @log.StatusCode
+                        </span>
+                    </td>
+
+                    <td class="text-nowrap">
+                        @log.Method @log.Path
+                    </td>
+
+                    <td>@(log.UserName ?? "гост")</td>
+
+                    <td>
+                        <strong>@log.ExceptionType</strong>
+                        <div>@log.Message</div>
+
+                        @if (!string.IsNullOrEmpty(log.StackTrace))
+                        {
+                            <details class="log-details">
+                                <summary>Stack trace</summary>
+                                <pre>@log.StackTrace</pre>
+                            </details>
+                        }
+                    </td>
+                </tr>
+            }
+            </tbody>
+        </table>
+    </div>
+
+    @if (totalPages > 1)
+    {
+        <nav class="mt-3">
+            <ul class="pagination">
+                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
+                    <a class="page-link"
+                       asp-controller="ErrorLogs"
+                       asp-action="Index"
+                       asp-route-page="@(currentPage - 1)">
+                        Назад
+                    </a>
+                </li>
+
+                @for (int i = 1; i <= totalPages; i++)
+                {
+                    <li class="page-item @(i == currentPage ? "active" : "")">
+                        <a class="page-link"
+                           asp-controller="ErrorLogs"
+                           asp-action="Index"
+                           asp-route-page="@i">
+                            @i
+                        </a>
+                    </li>
+                }
+
+                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
+                    <a class="page-link"
+                       asp-controller="ErrorLogs"
+                       asp-action="Index"
+                       asp-route-page="@(currentPage + 1)">
+                        Напред
+                    </a>
+                </li>
+            </ul>
+        </nav>
+    }
+}
