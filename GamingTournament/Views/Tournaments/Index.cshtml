@model List<GamingTournament.Models.Tournament>

@{
    ViewData["Title"] = "Турнири";
    DateTime today = DateTime.Today;
}

<h1 class="page-title">Турнири</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-controller="Tournaments"
           asp-action="Create"
           class="btn btn-primary">
            Създай нов турнир
        </a>
    </p>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Все още няма създадени турнири.
    </div>
}
else
{
    <div class="table-card table-responsive">
    <table class="table table-hover align-middle">
        <thead>
        <tr>
            <th>Име</th>
            <th>Игра</th>
            <th>Период</th>
            <th>Мачове</th>
            <th>Статус</th>
            @if (User.IsInRole("Admin"))
            {
                <th>Действия</th>
            }
        </tr>
        </thead>

        <tbody>
        @foreach (var tournament in Model)
        {
            <tr>
                <td>
                    <strong>@tournament.Name</strong>
                </td>

                <td>@tournament.Game</td>

                <td>
                    @tournament.StartDate.ToString("dd.MM.yyyy")
                    –
                    @tournament.EndDate.ToString("dd.MM.yyyy")
                </td>

                @* played / all, cancelled ones included in "all" *@
                <td>
                    @tournament.Matches.Count(match => match.Status == MatchStatus.Finished)
                    / @tournament.Matches.Count
                </td>

                <td>
                    @if (today < tournament.StartDate)
                    {
                        <span class="badge bg-primary">Предстоящ</span>
                    }
                    else if (today > tournament.EndDate)
                    {
                        <span class="badge bg-secondary">Приключил</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Тече</span>
                    }
                </td>

                @if (User.IsInRole("Admin"))
                {
                    <td>
                        @* only for a tournament without matches yet *@
                        @if (tournament.Matches.Count == 0)
                        {
                            <form asp-controller="Tournaments"
                                  asp-action="GenerateMatches"
                                  asp-route-id="@tournament.Id"
                                  method="post"
                                  onsubmit="return confirm('Да генерирам ли програма за всички отбори?');">
                                <button type="submit"
                                        class="btn btn-success btn-sm">
                                    Генерирай мачове
                                </button>
                            </form>
                        }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
    </div>
}
