@model GamingTournament.Models.HomeIndexViewModel

@{
    ViewData["Title"] = "Начало";
}

<section class="hero">
    <h1>GamingTournament</h1>

    <p class="lead">
        Отбори, играчи и мачове на едно място.
    </p>

    <div class="d-flex justify-content-center flex-wrap gap-2">
        <a asp-controller="Teams"
           asp-action="Index"
           class="btn btn-primary btn-lg">
            Към отборите
        </a>

        <a asp-controller="Matches"
           asp-action="Index"
           class="btn btn-outline-primary btn-lg">
            Всички мачове
        </a>

        @* guests only - logged in users already have an account *@
        @if (User.Identity == null || !User.Identity.IsAuthenticated)
        {
            <a asp-area="Identity"
               asp-page="/Account/Register"
               class="btn btn-success btn-lg">
                Регистрирай се
            </a>
        }
    </div>
</section>

<div class="row text-center mb-4">
    <div class="col-6 col-md-3 mb-3">
        <div class="card stat-card h-100">
            <div class="card-body py-4">
                <div class="stat-number">@Model.TeamCount</div>
                <div class="stat-label">Отбори</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3 mb-3">
        <div class="card stat-card h-100">
            <div class="card-body py-4">
                <div class="stat-number">@Model.PlayerCount</div>
                <div class="stat-label">Играчи в отбори</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3 mb-3">
        <div class="card stat-card h-100">
            <div class="card-body py-4">
                <div class="stat-number">@Model.FinishedMatchCount</div>
                <div class="stat-label">Изиграни мача</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3 mb-3">
        <div class="card stat-card h-100">
            <div class="card-body py-4">
                <div class="stat-number">@Model.ScheduledMatchCount</div>
                <div class="stat-label">Предстоящи мача</div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <h4 class="section-title">Предстоящи мачове</h4>

        @if (Model.UpcomingMatches.Count == 0)
        {
            <div class="alert alert-info">
                Няма насрочени мачове.
            </div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var match in Model.UpcomingMatches)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span>
                            <strong>@match.HomeTeam?.Name</strong>
                            <span class="text-muted mx-1">срещу</span>
                            <strong>@match.AwayTeam?.Name</strong>
                        </span>

                        <span class="badge bg-primary">
                            @match.ScheduledOn.ToString("dd.MM.yyyy HH:mm")
                        </span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="col-md-6 mb-4">
        <h4 class="section-title">Последни резултати</h4>

        @if (Model.RecentResults.Count == 0)
        {
            <div class="alert alert-info">
                Все още няма изиграни мачове.
            </div>
        }
        else
        {
            <ul class="list-group">
                @foreach (var match in Model.RecentResults)
                {
                    @* winner in bold, same as on the matches page *@
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span>
                            @if (match.WinnerTeamId == match.HomeTeamId)
                            {
                                <strong>@match.HomeTeam?.Name</strong>
                            }
                            else
                            {
                                @match.HomeTeam?.Name
                            }

                            <span class="score">@match.HomeScore : @match.AwayScore</span>

                            @if (match.WinnerTeamId == match.AwayTeamId)
                            {
                                <strong>@match.AwayTeam?.Name</strong>
                            }
                            else
                            {
                                @match.AwayTeam?.Name
                            }
                        </span>

                        <span class="text-muted small">
                            @match.ScheduledOn.ToString("dd.MM.yyyy")
                        </span>
                    </li>
                }
            </ul>
        }
    </div>
</div>
