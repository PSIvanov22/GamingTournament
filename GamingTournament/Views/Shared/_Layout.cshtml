<!DOCTYPE html>
<html lang="bg" data-bs-theme="dark">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - GamingTournament</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/GamingTournament.styles.css" asp-append-version="true"/>
</head>
<body>
@{
    // marks the current section in the menu
    string? currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    string ActiveClass(string controller) =>
        currentController == controller ? "active" : "";
}
<header>
    <nav class="navbar navbar-expand-md navbar-dark site-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">GamingTournament</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1 gap-1">
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("Home")" asp-area="" asp-controller="Home" asp-action="Index">Начало</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("Teams")" asp-area="" asp-controller="Teams" asp-action="Index">Отбори</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("Matches")" asp-area="" asp-controller="Matches" asp-action="Index">Мачове</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveClass("Tournaments")" asp-area="" asp-controller="Tournaments" asp-action="Index">Турнири</a>
                    </li>
                </ul>
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>
<div class="container flex-grow-1">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="site-footer">
    <div class="container d-flex justify-content-between flex-wrap gap-2">
        <span>&copy; 2026 GamingTournament</span>
        <a asp-area="" asp-controller="Home" asp-action="Privacy">Поверителност</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
