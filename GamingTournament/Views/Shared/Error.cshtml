@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="error-page">
    <div class="error-code error-code-danger">@Model.StatusCode</div>

    <h1>@Model.Title</h1>

    <p class="lead">@Model.Message</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            Код на грешката:
            <code>@Model.RequestId</code>
        </p>
    }

    <div class="d-flex justify-content-center flex-wrap gap-2 mt-4">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary">
            Към началото
        </a>

        <a href="javascript:history.back()"
           class="btn btn-outline-primary">
            Назад
        </a>
    </div>

    @* only the Development environment fills Details *@
    @if (!string.IsNullOrEmpty(Model.Details))
    {
        <details class="error-details text-start mt-4">
            <summary>Технически подробности (само в Development)</summary>
            <pre>@Model.Details</pre>
        </details>
    }
</section>
